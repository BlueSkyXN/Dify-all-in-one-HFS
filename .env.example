# Local-only HFS value ledger. Do not upload this file or put real values in Git.
# HF_TOKEN and GH_TOKEN are control-plane credentials only; never Space Settings.
HF_TOKEN=
GH_TOKEN=

# Hugging Face Space Secrets (leave blank in the template).
DIFY_ARTIFACT_BEARER_TOKEN=
OPS_TOKEN=
DB_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=
CODE_EXECUTION_API_KEY=
SANDBOX_API_KEY=
DIFY_AGENT_SERVER_SECRET_KEY=
DIFY_AGENT_SHELLCTL_AUTH_TOKEN=
ADMIN_TOKEN=

# Hugging Face Space Variables. The release owner supplies an exact bucket URI
# and immutable source SHA at promotion time; this template intentionally does
# not name a private namespace or release.
DIFY_ARTIFACT_MANIFEST_HF_URI=
DIFY_ARTIFACT_EXPECTED_SOURCE_REF=
DIFY_ARTIFACT_MAX_BYTES=4294967296
PERSIST_MODE=bucket
POSTGRES_BUCKET_FAILURE_MODE=exit
ADMIN_ENABLED=false
ADMIN_FILES_DESTRUCTIVE_ENABLED=false
ADMIN_FILES_ENABLED=false
ADMIN_FILES_ROOT=/data
ADMIN_FILES_WRITE_ENABLED=false
AGENT_DRIVE_MANIFEST_ENABLED=true
DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR=10
DIFY_AGENT_ENABLED=true
ENABLE_AGENT_V2=true
ENABLE_COLLABORATION_MODE=true
ENABLE_OAUTH_BEARER=false
ENABLE_WORKFLOW_RUN_CLEANUP_TASK=false
NEXT_PUBLIC_ENABLE_AGENT_V2=true
NEXT_PUBLIC_ENABLE_COLLABORATION_MODE=true
NEXT_PUBLIC_SOCKET_URL=
OPENAPI_ENABLED=false
OPENAPI_KNOWN_CLIENT_IDS=difyctl
OPENAPI_RATE_LIMIT_PER_TOKEN=60
PLUGIN_CWD_PERSISTENCE=true
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=120
PLUGIN_SSL_EOF_MAX_RETRIES=0
PLUGIN_UV_CACHE_DIR=/tmp/dify-aio/plugin-uv-cache
SANDBOX_ENABLE_NETWORK=false
SANDBOX_SELFCHECK_STRICT=true
WORKFLOW_LOG_CLEANUP_ENABLED=false

# Local Docker-only controls. Do not sync these to Space Settings.
PUBLIC_URL=http://localhost:8080
PERSIST_VOLUME=dify-hf-demo-persist
