# Local-only HFS value ledger. Do not upload this file or put real values in Git.
# HF_TOKEN and GH_TOKEN are control-plane credentials only; never Space Settings.
HF_TOKEN=
GH_TOKEN=

# Hugging Face Space Secrets (leave blank in the template).
DIFY_ARTIFACT_BEARER_TOKEN=
OPS_TOKEN=
DB_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=
CODE_EXECUTION_API_KEY=
ADMIN_TOKEN=

# Hugging Face Space Variables. The release owner supplies an exact bucket URI
# and immutable source SHA at promotion time; this template intentionally does
# not name a private namespace or release.
DIFY_ARTIFACT_MANIFEST_HF_URI=
DIFY_ARTIFACT_EXPECTED_SOURCE_REF=
DIFY_ARTIFACT_MAX_BYTES=4294967296
PERSIST_MODE=bucket
POSTGRES_BUCKET_FAILURE_MODE=exit
ADMIN_ENABLED=false

# Local Docker-only controls. Do not sync these to Space Settings.
PUBLIC_URL=http://localhost:8080
PERSIST_VOLUME=dify-hf-demo-persist
