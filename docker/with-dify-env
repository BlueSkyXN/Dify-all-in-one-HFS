#!/usr/bin/env bash
set -euo pipefail
set -a
# shellcheck disable=SC1091
. /etc/dify/dify.env.runtime
if [ -f /data/config/generated.env ]; then
  # shellcheck disable=SC1091
  . /data/config/generated.env
elif [ -f /etc/dify/generated.env ]; then
  # legacy fallback
  # shellcheck disable=SC1091
  . /etc/dify/generated.env
fi
set +a
export VIRTUAL_ENV="${VIRTUAL_ENV:-/app/api/.venv}"
case ":${PATH:-}:" in
  *":${VIRTUAL_ENV}/bin:"*) ;;
  *) export PATH="${VIRTUAL_ENV}/bin:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}" ;;
esac
exec "$@"
