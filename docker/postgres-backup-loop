#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '[dify-aio-pg-backup] %s\n' "$*"
}

source_env() {
  set -a
  # shellcheck disable=SC1091
  . /etc/dify/dify.env.runtime
  if [ -f /data/config/generated.env ]; then
    # shellcheck disable=SC1091
    . /data/config/generated.env
  elif [ -f /etc/dify/generated.env ]; then
    # legacy fallback
    # shellcheck disable=SC1091
    . /etc/dify/generated.env
  fi
  set +a
}

is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

backup_enabled() {
  source_env
  case "${POSTGRES_BACKUP_ENABLED:-auto}" in
    auto)
      [ -f "${PERSIST_ACTIVE_FILE:-${RUNTIME_ROOT:-/tmp/dify-aio}/persist-active}" ]
      ;;
    1|true|TRUE|yes|YES|on|ON)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

wait_for_postgres() {
  source_env
  until pg_isready -h /data/run/postgresql -p "${DB_PORT:-5432}" -U user -d postgres >/dev/null 2>&1; do
    sleep 2
  done
}

backup_retain_count() {
  local retain=${POSTGRES_BACKUP_RETAIN_COUNT:-5}
  if ! [[ "$retain" =~ ^[0-9]+$ ]] || [ "$retain" -lt 1 ]; then
    retain=5
  fi
  if [ "$retain" -gt 50 ]; then
    retain=50
  fi
  printf '%s\n' "$retain"
}

prune_old_backups() {
  local retain=$1
  local -a backups=()
  local backup
  mapfile -t backups < <(find "${POSTGRES_BACKUP_DIR}" -maxdepth 1 -type f -name '[0-9]*T[0-9]*Z.sql.gz' | sort -r)
  if [ "${#backups[@]}" -le "$retain" ]; then
    return
  fi
  for backup in "${backups[@]:$retain}"; do
    rm -f "$backup" "${backup%.sql.gz}.sha256" "${backup%.sql.gz}.err"
  done
}

run_backup_once() {
  source_env
  mkdir -p "${POSTGRES_BACKUP_DIR}"
  local retain
  retain=$(backup_retain_count)
  local stamp
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  local target="${POSTGRES_BACKUP_DIR}/${stamp}.sql.gz"
  local tmp="${target}.tmp"
  local err="${POSTGRES_BACKUP_DIR}/${stamp}.err"

  log "Writing PostgreSQL dump to ${target}"
  if ! pg_dumpall \
    -h /data/run/postgresql \
    -p "${DB_PORT:-5432}" \
    -U user \
    --no-role-passwords \
    2>"$err" \
    | gzip -c > "$tmp"; then
    cp "$err" "${POSTGRES_BACKUP_DIR}/latest.err"
    rm -f "$tmp"
    return 1
  fi
  if ! gzip -t "$tmp" >/dev/null 2>&1 || [ ! -s "$tmp" ]; then
    printf 'invalid or empty backup artifact\n' > "$err"
    cp "$err" "${POSTGRES_BACKUP_DIR}/latest.err"
    rm -f "$tmp"
    return 1
  fi
  local sha
  sha=$(sha256sum "$tmp" | awk '{print $1}')
  mv "$tmp" "$target"
  printf '%s  %s\n' "$sha" "$(basename "$target")" > "${target%.sql.gz}.sha256"
  cp "$target" "${POSTGRES_BACKUP_DIR}/latest.sql.gz.tmp"
  mv "${POSTGRES_BACKUP_DIR}/latest.sql.gz.tmp" "${POSTGRES_BACKUP_DIR}/latest.sql.gz"
  printf '%s\n' "$stamp" > "${POSTGRES_BACKUP_DIR}/latest.created_at"
  printf '%s\n' "$sha" > "${POSTGRES_BACKUP_DIR}/latest.sha256"
  rm -f "$err" "${POSTGRES_BACKUP_DIR}/latest.err"
  prune_old_backups "$retain"
}

main() {
  source_env
  if ! backup_enabled; then
    log "PostgreSQL backup loop disabled."
    exec sleep infinity
  fi

  wait_for_postgres
  local initial_delay=${POSTGRES_BACKUP_INITIAL_DELAY_SECONDS:-60}
  local interval=${POSTGRES_BACKUP_INTERVAL_SECONDS:-3600}
  if ! [[ "$initial_delay" =~ ^[0-9]+$ ]]; then
    initial_delay=600
  fi
  if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 60 ]; then
    interval=3600
  fi

  log "PostgreSQL backup loop enabled; first backup in ${initial_delay}s, interval ${interval}s."
  sleep "$initial_delay"
  while backup_enabled; do
    if ! run_backup_once; then
      log "Backup failed; retrying after ${interval}s."
    fi
    sleep "$interval"
  done
  log "PostgreSQL backup loop disabled after runtime config reload."
  exec sleep infinity
}

main "$@"
