--- a/internal/core/runner/init.go
+++ b/internal/core/runner/init.go
@@ -5,0 +6 @@ import (
+	"os"
@@ -13,0 +15,11 @@ func init() {
+	if gidOverride := strings.TrimSpace(os.Getenv("SANDBOX_RUN_GID")); gidOverride != "" {
+		gid, err := strconv.Atoi(gidOverride)
+		if err != nil {
+			slog.Error("failed to parse SANDBOX_RUN_GID", "err", err, "value", gidOverride)
+			panic(fmt.Sprintf("failed to parse SANDBOX_RUN_GID: %v", err))
+		}
+		static.SANDBOX_GROUP_ID = gid
+		slog.Info("sandbox group id overridden", "gid", gid)
+		return
+	}
