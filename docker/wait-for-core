#!/usr/bin/env bash
set -euo pipefail
set -a
# shellcheck disable=SC1091
. /etc/dify/dify.env.runtime
if [ -f /data/config/generated.env ]; then
  # shellcheck disable=SC1091
  . /data/config/generated.env
elif [ -f /etc/dify/generated.env ]; then
  # legacy fallback
  # shellcheck disable=SC1091
  . /etc/dify/generated.env
fi
set +a

wait_postgres() {
  until PGPASSWORD="${DB_PASSWORD:-}" PGSSLMODE="${DB_SSL_MODE:-disable}" \
    pg_isready -h "${DB_HOST:-127.0.0.1}" -p "${DB_PORT:-5432}" -U "${DB_USERNAME:-dify}" >/dev/null 2>&1; do
    sleep 1
  done
}

wait_redis() {
  local args=(-h "${REDIS_HOST:-127.0.0.1}" -p "${REDIS_PORT:-6379}")
  until redis_cli "${args[@]}" ping 2>/dev/null | grep -q PONG; do
    sleep 1
  done
}

redis_cli() {
  if [ -n "${REDIS_PASSWORD:-}" ]; then
    REDISCLI_AUTH="${REDIS_PASSWORD}" redis-cli "$@"
  else
    redis-cli "$@"
  fi
}

wait_api() {
  until curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:5001/health >/dev/null 2>&1; do
    sleep 1
  done
}

wait_plugin_daemon() {
  local host=127.0.0.1
  local port=${PLUGIN_DAEMON_PORT:-5002}
  until nc -z "$host" "$port" >/dev/null 2>&1; do
    sleep 1
  done
}

wait_shellctl() {
  local endpoint=${DIFY_AGENT_SHELLCTL_ENTRYPOINT:-http://127.0.0.1:5004}
  local host_port host port
  host_port=${endpoint#http://}
  host_port=${host_port#https://}
  host_port=${host_port%%/*}
  host=${host_port%:*}
  port=${host_port##*:}
  if [ "$host" = "$host_port" ] || [ -z "$host" ] || [ -z "$port" ]; then
    host=127.0.0.1
    port=5004
  fi
  until nc -z "$host" "$port" >/dev/null 2>&1; do
    sleep 1
  done
}

while [ $# -gt 0 ]; do
  case "$1" in
    postgres) wait_postgres ;;
    redis) wait_redis ;;
    api) wait_api ;;
    plugin-daemon) wait_plugin_daemon ;;
    shellctl) wait_shellctl ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

exec "$@"
