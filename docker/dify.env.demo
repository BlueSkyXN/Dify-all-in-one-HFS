# Copy or pass this file to docker run: --env-file docker/dify.env.demo
# Demo/training defaults. Do not use these passwords in production.
# DEMO ONLY: this file intentionally contains weak local-training defaults.
# DO NOT use it for public Spaces, shared environments, or production systems.

PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8080
SERVER_CONSOLE_API_URL=http://127.0.0.1:5001
DEPLOY_ENV=PRODUCTION
EDITION=SELF_HOSTED
LOG_LEVEL=INFO

# Leave blank to auto-generate persistent values in /data/config/generated.env.
# With a /persist mount, bucket-lite maps this to /persist/config/generated.env.
SECRET_KEY=
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=
CODE_EXECUTION_API_KEY=
SANDBOX_API_KEY=

# Artifact delivery is fail-closed. Supply the manifest URI and bearer token
# through local-only Docker environment controls when running this demo.
DIFY_ARTIFACT_MANIFEST_HF_URI=
DIFY_ARTIFACT_BEARER_TOKEN=
DIFY_ARTIFACT_EXPECTED_SOURCE_REF=

# Local PostgreSQL + pgvector.
DB_USERNAME=dify
DB_PASSWORD=dify_demo_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin
VECTOR_STORE=pgvector
PGVECTOR_HOST=127.0.0.1
PGVECTOR_PORT=5432
PGVECTOR_USER=dify
PGVECTOR_PASSWORD=dify_demo_password
PGVECTOR_DATABASE=dify

# Local Redis.
PERSIST_MODE=auto
REDIS_PERSISTENCE=false
POSTGRES_BACKUP_ENABLED=auto
POSTGRES_BACKUP_INITIAL_DELAY_SECONDS=15
POSTGRES_BACKUP_RETENTION_POLICY=tiered
POSTGRES_BACKUP_RETAIN_COUNT=65
POSTGRES_BACKUP_COMPRESSION_LEVEL=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dify_redis_password
CELERY_BROKER_URL=redis://:dify_redis_password@127.0.0.1:6379/1
CELERY_BACKEND=redis

# File storage.
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=/data/dify/storage

# Same-container Plugin Daemon.
PLUGIN_DAEMON_URL=http://127.0.0.1:5002
PLUGIN_DIFY_INNER_API_URL=http://127.0.0.1:5001
PLUGIN_STORAGE_TYPE=local
PLUGIN_STORAGE_LOCAL_ROOT=/data/plugin_daemon
PLUGIN_WORKING_PATH=/data/plugin_daemon/cwd
PLUGIN_UV_CACHE_DIR=/tmp/dify-aio/plugin-uv-cache
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=https://marketplace.dify.ai
# Demo convenience. For enterprise training, prefer signed plugins and set this to true.
FORCE_VERIFYING_SIGNATURE=false
ENFORCE_LANGGENIUS_PLUGIN_SIGNATURES=false

# Same-container Sandbox. Default no network access for safer training.
CODE_EXECUTION_ENDPOINT=http://127.0.0.1:8194
SANDBOX_ENABLE_NETWORK=false
SANDBOX_GIN_MODE=release
SANDBOX_WORKER_TIMEOUT=15

# Web/runtime limits.
NEXT_TELEMETRY_DISABLED=1
DISABLE_TELEMETRY=true
TEXT_GENERATION_TIMEOUT_MS=120000
PLUGIN_MAX_REQUEST_TIMEOUT=300
PLUGIN_CONNECT_TIMEOUT_SECONDS=60
UPLOAD_FILE_SIZE_LIMIT=100
SERVER_WORKER_AMOUNT=1
CELERY_WORKER_AMOUNT=1
GUNICORN_TIMEOUT=360
ENABLE_AGENT_V2=true
NEXT_PUBLIC_ENABLE_AGENT_V2=true
ENABLE_COLLABORATION_MODE=true
NEXT_PUBLIC_ENABLE_COLLABORATION_MODE=true

# OpenAPI / difyctl stays off in the local stable demo unless explicitly tested.
OPENAPI_ENABLED=false
OPENAPI_CORS_ALLOW_ORIGINS=
OPENAPI_KNOWN_CLIENT_IDS=difyctl
OPENAPI_RATE_LIMIT_PER_TOKEN=60
DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR=10
ENABLE_OAUTH_BEARER=false

# Agent v2 / dify-agent backend is enabled in the NEXT demo.
DIFY_AGENT_ENABLED=true
DIFY_AGENT_HOST=127.0.0.1
DIFY_AGENT_PORT=5005
DIFY_AGENT_STARTUP_DELAY_SECONDS=30
AGENT_BACKEND_USE_FAKE=false
AGENT_SHELL_ENABLED=true
AGENT_DRIVE_MANIFEST_ENABLED=true
DIFY_AGENT_SHELLCTL_ENTRYPOINT=http://127.0.0.1:5004
DIFY_AGENT_RUNTIME_BACKEND=local
DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT=http://127.0.0.1:5004

# Local demo diagnostics token. Public Spaces should set a strong OPS_TOKEN and
# leave ALLOW_DEMO_OPS_TOKEN unset/false.
OPS_TOKEN=dify_ops_demo_token
ALLOW_DEMO_OPS_TOKEN=true

# Optional admin surface. Keep disabled unless explicitly testing management actions.
ADMIN_ENABLED=false
ADMIN_TOKEN=
ADMIN_FILES_ENABLED=false
ADMIN_FILES_WRITE_ENABLED=false
ADMIN_FILES_DESTRUCTIVE_ENABLED=false
