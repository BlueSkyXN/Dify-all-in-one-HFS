#!/usr/bin/env bash
set -euo pipefail
set -a
# shellcheck disable=SC1091
. /etc/dify/dify.env.runtime
if [ -f /data/config/generated.env ]; then
  # shellcheck disable=SC1091
  . /data/config/generated.env
elif [ -f /etc/dify/generated.env ]; then
  # legacy fallback
  # shellcheck disable=SC1091
  . /etc/dify/generated.env
fi
export API_KEY="${SANDBOX_API_KEY:-${CODE_EXECUTION_API_KEY}}"
export GIN_MODE="${SANDBOX_GIN_MODE:-release}"
export WORKER_TIMEOUT="${SANDBOX_WORKER_TIMEOUT:-15}"
export ENABLE_NETWORK="${SANDBOX_ENABLE_NETWORK:-false}"
export SANDBOX_PORT="${SANDBOX_PORT:-8194}"
export PYTHON_PATH="${SANDBOX_PYTHON_PATH:-/usr/local/bin/python3}"
export NODEJS_PATH="${SANDBOX_NODEJS_PATH:-/usr/bin/node}"
export PYTHON_LIB_PATH="${SANDBOX_PYTHON_LIB_PATH:-/usr/local/lib/python3.12,/usr/lib/x86_64-linux-gnu,/lib/x86_64-linux-gnu,/etc/ssl/certs/ca-certificates.crt,/etc/nsswitch.conf,/etc/hosts,/etc/resolv.conf,/run/systemd/resolve/stub-resolv.conf,/run/resolvconf/resolv.conf,/etc/localtime,/usr/share/zoneinfo,/etc/timezone}"
export PYTHON_DEPS_UPDATE_INTERVAL="${SANDBOX_PYTHON_DEPS_UPDATE_INTERVAL:-30m}"
export HTTP_PROXY="${SANDBOX_HTTP_PROXY:-}"
export HTTPS_PROXY="${SANDBOX_HTTPS_PROXY:-}"
export PIP_MIRROR_URL="${PIP_MIRROR_URL:-}"
set +a

# Dify Sandbox marks copied Python files read-only. Under the HF rootless
# wrapper, a restarted sandbox cannot overwrite leftovers from a failed init.
rm -rf /var/sandbox/sandbox-python
mkdir -p /var/sandbox/sandbox-python
chmod 755 /var/sandbox /var/sandbox/sandbox-python || true

exec "$@"
