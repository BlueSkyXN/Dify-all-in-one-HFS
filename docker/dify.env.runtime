# shellcheck shell=bash
# Runtime defaults for the all-in-one Dify demo image.
# This file is sourced by wrapper scripts. Each line preserves Docker-provided env vars.

export EDITION=${EDITION:-SELF_HOSTED}
export DEPLOY_ENV=${DEPLOY_ENV:-PRODUCTION}
export DEBUG=${DEBUG:-false}
export FLASK_DEBUG=${FLASK_DEBUG:-false}
export LOG_LEVEL=${LOG_LEVEL:-INFO}
export LOG_OUTPUT_FORMAT=${LOG_OUTPUT_FORMAT:-text}
export LOG_FILE=${LOG_FILE:-/data/logs/dify-api.log}
export LOG_FILE_MAX_SIZE=${LOG_FILE_MAX_SIZE:-20}
export LOG_FILE_BACKUP_COUNT=${LOG_FILE_BACKUP_COUNT:-5}
export LOG_DATEFORMAT=${LOG_DATEFORMAT:-%Y-%m-%d %H:%M:%S}
export LOG_TZ=${LOG_TZ:-UTC}
export ENABLE_REQUEST_LOGGING=${ENABLE_REQUEST_LOGGING:-false}

# Storage layout. In auto mode, a mounted and writable /persist enables the
# bucket-lite layout: core state on /persist, scratch/cache on /tmp/dify-aio.
export PERSIST_MODE=${PERSIST_MODE:-auto}
export PERSIST_ROOT=${PERSIST_ROOT:-/persist}
export RUNTIME_ROOT=${RUNTIME_ROOT:-/tmp/dify-aio}
export PERSIST_ACTIVE_FILE=${PERSIST_ACTIVE_FILE:-${RUNTIME_ROOT}/persist-active}
export REDIS_PERSISTENCE=${REDIS_PERSISTENCE:-false}
export PLUGIN_CWD_PERSISTENCE=${PLUGIN_CWD_PERSISTENCE:-false}
export POSTGRES_BUCKET_FAILURE_MODE=${POSTGRES_BUCKET_FAILURE_MODE:-fallback-to-runtime}
export POSTGRES_BACKUP_ENABLED=${POSTGRES_BACKUP_ENABLED:-auto}
export POSTGRES_BACKUP_DIR=${POSTGRES_BACKUP_DIR:-${PERSIST_ROOT}/postgres-backups}
export POSTGRES_BACKUP_INTERVAL_SECONDS=${POSTGRES_BACKUP_INTERVAL_SECONDS:-60}
export POSTGRES_BACKUP_INITIAL_DELAY_SECONDS=${POSTGRES_BACKUP_INITIAL_DELAY_SECONDS:-15}
export POSTGRES_BACKUP_RETENTION_POLICY=${POSTGRES_BACKUP_RETENTION_POLICY:-tiered}
export POSTGRES_BACKUP_RETAIN_COUNT=${POSTGRES_BACKUP_RETAIN_COUNT:-65}
export POSTGRES_BACKUP_COMPRESSION_LEVEL=${POSTGRES_BACKUP_COMPRESSION_LEVEL:-1}
export HF_HOME=${HF_HOME:-${RUNTIME_ROOT}/hf-cache}
export HF_HUB_CACHE=${HF_HUB_CACHE:-${HF_HOME}/hub}

# External URL seen by the browser. On Hugging Face Spaces, SPACE_HOST is injected at runtime.
if [ -z "${PUBLIC_URL:-}" ] && [ -n "${SPACE_HOST:-}" ]; then
  export PUBLIC_URL="https://${SPACE_HOST}"
else
  export PUBLIC_URL=${PUBLIC_URL:-http://localhost:8080}
fi
export CONSOLE_WEB_URL=${CONSOLE_WEB_URL:-${PUBLIC_URL}}
export CONSOLE_API_URL=${CONSOLE_API_URL:-${PUBLIC_URL}}
# Dify Web SSR must call the same-container API without re-entering the public HF edge.
export SERVER_CONSOLE_API_URL=${SERVER_CONSOLE_API_URL:-http://127.0.0.1:5001}
export SERVICE_API_URL=${SERVICE_API_URL:-http://127.0.0.1:5001}
export APP_WEB_URL=${APP_WEB_URL:-${PUBLIC_URL}}
export APP_API_URL=${APP_API_URL:-${PUBLIC_URL}}
export FILES_URL=${FILES_URL:-${PUBLIC_URL}}
export INTERNAL_FILES_URL=${INTERNAL_FILES_URL:-http://127.0.0.1:5001}
if [ -z "${ENDPOINT_URL_TEMPLATE:-}" ]; then
  export ENDPOINT_URL_TEMPLATE="${PUBLIC_URL}/e/{hook_id}"
else
  export ENDPOINT_URL_TEMPLATE
fi
export TRIGGER_URL=${TRIGGER_URL:-${PUBLIC_URL}}
if [ -z "${NEXT_PUBLIC_SOCKET_URL:-}" ]; then
  case "${PUBLIC_URL}" in
    https://*) export NEXT_PUBLIC_SOCKET_URL="wss://${PUBLIC_URL#https://}" ;;
    http://*) export NEXT_PUBLIC_SOCKET_URL="ws://${PUBLIC_URL#http://}" ;;
    *) export NEXT_PUBLIC_SOCKET_URL="" ;;
  esac
else
  export NEXT_PUBLIC_SOCKET_URL
fi

# Security keys are generated persistently by entrypoint if left blank.
export SECRET_KEY=${SECRET_KEY:-}
export INIT_PASSWORD=${INIT_PASSWORD:-}

# API and worker process settings.
export MIGRATION_ENABLED=${MIGRATION_ENABLED:-true}
export DIFY_BIND_ADDRESS=${DIFY_BIND_ADDRESS:-0.0.0.0}
export DIFY_PORT=${DIFY_PORT:-5001}
export SERVER_WORKER_AMOUNT=${SERVER_WORKER_AMOUNT:-1}
export SERVER_WORKER_CLASS=${SERVER_WORKER_CLASS:-geventwebsocket.gunicorn.workers.GeventWebSocketWorker}
export SERVER_WORKER_CONNECTIONS=${SERVER_WORKER_CONNECTIONS:-10}
export GUNICORN_TIMEOUT=${GUNICORN_TIMEOUT:-360}
export API_WEBSOCKET_WORKER_CLASS=${API_WEBSOCKET_WORKER_CLASS:-geventwebsocket.gunicorn.workers.GeventWebSocketWorker}
export API_WEBSOCKET_WORKER_CONNECTIONS=${API_WEBSOCKET_WORKER_CONNECTIONS:-1000}
export API_WEBSOCKET_GUNICORN_TIMEOUT=${API_WEBSOCKET_GUNICORN_TIMEOUT:-360}
export CELERY_WORKER_CLASS=${CELERY_WORKER_CLASS:-gevent}
export CELERY_WORKER_AMOUNT=${CELERY_WORKER_AMOUNT:-1}
export CELERY_AUTO_SCALE=${CELERY_AUTO_SCALE:-false}
export CELERY_MAX_WORKERS=${CELERY_MAX_WORKERS:-}
export CELERY_MIN_WORKERS=${CELERY_MIN_WORKERS:-}
export CELERY_PREFETCH_MULTIPLIER=${CELERY_PREFETCH_MULTIPLIER:-1}
export MAX_TASKS_PER_CHILD=${MAX_TASKS_PER_CHILD:-50}
export COMPOSE_WORKER_HEALTHCHECK_DISABLED=${COMPOSE_WORKER_HEALTHCHECK_DISABLED:-true}
export WORKFLOW_LOG_CLEANUP_ENABLED=${WORKFLOW_LOG_CLEANUP_ENABLED:-false}
export WORKFLOW_LOG_RETENTION_DAYS=${WORKFLOW_LOG_RETENTION_DAYS:-30}
export WORKFLOW_LOG_CLEANUP_BATCH_SIZE=${WORKFLOW_LOG_CLEANUP_BATCH_SIZE:-100}
export WORKFLOW_LOG_CLEANUP_SPECIFIC_WORKFLOW_IDS=${WORKFLOW_LOG_CLEANUP_SPECIFIC_WORKFLOW_IDS:-}
export ENABLE_WORKFLOW_RUN_CLEANUP_TASK=${ENABLE_WORKFLOW_RUN_CLEANUP_TASK:-false}

# PostgreSQL: demo uses local PostgreSQL + pgvector.
export DB_TYPE=${DB_TYPE:-postgresql}
export EXTERNAL_POSTGRES_ENABLED=${EXTERNAL_POSTGRES_ENABLED:-false}
export EXTERNAL_POSTGRES_WAIT_SECONDS=${EXTERNAL_POSTGRES_WAIT_SECONDS:-120}
export EXTERNAL_POSTGRES_REQUIRE_VECTOR=${EXTERNAL_POSTGRES_REQUIRE_VECTOR:-true}
export DB_USERNAME=${DB_USERNAME:-dify}
export DB_PASSWORD=${DB_PASSWORD:-dify_demo_password}
export DB_HOST=${DB_HOST:-127.0.0.1}
export DB_PORT=${DB_PORT:-5432}
export DB_DATABASE=${DB_DATABASE:-dify}
export DB_SSL_MODE=${DB_SSL_MODE:-disable}
export SQLALCHEMY_POOL_SIZE=${SQLALCHEMY_POOL_SIZE:-10}
export SQLALCHEMY_MAX_OVERFLOW=${SQLALCHEMY_MAX_OVERFLOW:-5}
export SQLALCHEMY_POOL_RECYCLE=${SQLALCHEMY_POOL_RECYCLE:-3600}
export SQLALCHEMY_ECHO=${SQLALCHEMY_ECHO:-false}
export SQLALCHEMY_POOL_PRE_PING=${SQLALCHEMY_POOL_PRE_PING:-true}
export SQLALCHEMY_POOL_USE_LIFO=${SQLALCHEMY_POOL_USE_LIFO:-false}
export SQLALCHEMY_POOL_TIMEOUT=${SQLALCHEMY_POOL_TIMEOUT:-30}
export SQLALCHEMY_POOL_RESET_ON_RETURN=${SQLALCHEMY_POOL_RESET_ON_RETURN:-rollback}

# Redis: demo uses local Redis.
export REDIS_HOST=${REDIS_HOST:-127.0.0.1}
export REDIS_PORT=${REDIS_PORT:-6379}
export REDIS_USERNAME=${REDIS_USERNAME:-}
export REDIS_PASSWORD=${REDIS_PASSWORD:-dify_redis_password}
export REDIS_USE_SSL=${REDIS_USE_SSL:-false}
export REDIS_SSL_CERT_REQS=${REDIS_SSL_CERT_REQS:-CERT_NONE}
export REDIS_DB=${REDIS_DB:-0}
export REDIS_KEY_PREFIX=${REDIS_KEY_PREFIX:-}
export REDIS_SOCKET_TIMEOUT=${REDIS_SOCKET_TIMEOUT:-5.0}
export REDIS_SOCKET_CONNECT_TIMEOUT=${REDIS_SOCKET_CONNECT_TIMEOUT:-5.0}
export REDIS_HEALTH_CHECK_INTERVAL=${REDIS_HEALTH_CHECK_INTERVAL:-30}
export CELERY_BROKER_URL=${CELERY_BROKER_URL:-redis://:${REDIS_PASSWORD}@127.0.0.1:6379/1}
export CELERY_BACKEND=${CELERY_BACKEND:-redis}
export BROKER_USE_SSL=${BROKER_USE_SSL:-false}
export EVENT_BUS_REDIS_URL=${EVENT_BUS_REDIS_URL:-}

# Web / browser settings.
export WEB_API_CORS_ALLOW_ORIGINS=${WEB_API_CORS_ALLOW_ORIGINS:-*}
export CONSOLE_CORS_ALLOW_ORIGINS=${CONSOLE_CORS_ALLOW_ORIGINS:-*}
export COOKIE_DOMAIN=${COOKIE_DOMAIN:-}
export NEXT_PUBLIC_COOKIE_DOMAIN=${NEXT_PUBLIC_COOKIE_DOMAIN:-}
export NEXT_PUBLIC_BATCH_CONCURRENCY=${NEXT_PUBLIC_BATCH_CONCURRENCY:-5}
export SENTRY_DSN=${WEB_SENTRY_DSN:-}
export WEB_SENTRY_DSN=${WEB_SENTRY_DSN:-}
export AMPLITUDE_API_KEY=${AMPLITUDE_API_KEY:-}
export TEXT_GENERATION_TIMEOUT_MS=${TEXT_GENERATION_TIMEOUT_MS:-120000}
export CSP_WHITELIST=${CSP_WHITELIST:-}
export ALLOW_EMBED=${ALLOW_EMBED:-false}
export ALLOW_INLINE_STYLES=${ALLOW_INLINE_STYLES:-false}
export ALLOW_UNSAFE_DATA_SCHEME=${ALLOW_UNSAFE_DATA_SCHEME:-false}
export TOP_K_MAX_VALUE=${TOP_K_MAX_VALUE:-10}
export INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=${INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH:-4000}
export LOOP_NODE_MAX_COUNT=${LOOP_NODE_MAX_COUNT:-100}
export MAX_TOOLS_NUM=${MAX_TOOLS_NUM:-10}
export MAX_PARALLEL_LIMIT=${MAX_PARALLEL_LIMIT:-10}
export MAX_ITERATIONS_NUM=${MAX_ITERATIONS_NUM:-99}
export MAX_TREE_DEPTH=${MAX_TREE_DEPTH:-50}
export ENABLE_WEBSITE_JINAREADER=${ENABLE_WEBSITE_JINAREADER:-true}
export ENABLE_WEBSITE_FIRECRAWL=${ENABLE_WEBSITE_FIRECRAWL:-true}
export ENABLE_WEBSITE_WATERCRAWL=${ENABLE_WEBSITE_WATERCRAWL:-true}
export NEXT_PUBLIC_ENABLE_SINGLE_DOLLAR_LATEX=${NEXT_PUBLIC_ENABLE_SINGLE_DOLLAR_LATEX:-false}
export EXPERIMENTAL_ENABLE_VINEXT=${EXPERIMENTAL_ENABLE_VINEXT:-false}
export NEXT_TELEMETRY_DISABLED=${NEXT_TELEMETRY_DISABLED:-1}
export ENABLE_AGENT_V2=${ENABLE_AGENT_V2:-true}
export NEXT_PUBLIC_ENABLE_AGENT_V2=${NEXT_PUBLIC_ENABLE_AGENT_V2:-${ENABLE_AGENT_V2}}
export ENABLE_COLLABORATION_MODE=${ENABLE_COLLABORATION_MODE:-true}
export NEXT_PUBLIC_ENABLE_COLLABORATION_MODE=${NEXT_PUBLIC_ENABLE_COLLABORATION_MODE:-${ENABLE_COLLABORATION_MODE}}
export CREATORS_PLATFORM_FEATURES_ENABLED=${CREATORS_PLATFORM_FEATURES_ENABLED:-false}
export CREATORS_PLATFORM_API_URL=${CREATORS_PLATFORM_API_URL:-https://creators.dify.ai}
export CREATORS_PLATFORM_OAUTH_CLIENT_ID=${CREATORS_PLATFORM_OAUTH_CLIENT_ID:-}
export NEXT_PUBLIC_CREATORS_PLATFORM_FEATURES_ENABLED=${NEXT_PUBLIC_CREATORS_PLATFORM_FEATURES_ENABLED:-${CREATORS_PLATFORM_FEATURES_ENABLED}}
export MARKETPLACE_API_URL=${MARKETPLACE_API_URL:-https://marketplace.dify.ai}
export MARKETPLACE_URL=${MARKETPLACE_URL:-https://marketplace.dify.ai}

# OpenAPI / difyctl. Keep default-off for stable; enable only in controlled NEXT Spaces.
export OPENAPI_ENABLED=${OPENAPI_ENABLED:-false}
export OPENAPI_CORS_ALLOW_ORIGINS=${OPENAPI_CORS_ALLOW_ORIGINS:-}
export OPENAPI_KNOWN_CLIENT_IDS=${OPENAPI_KNOWN_CLIENT_IDS:-difyctl}
export OPENAPI_RATE_LIMIT_PER_TOKEN=${OPENAPI_RATE_LIMIT_PER_TOKEN:-60}
export DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR=${DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR:-10}
export ENABLE_OAUTH_BEARER=${ENABLE_OAUTH_BEARER:-false}
export DSL_EXPORT_ENCRYPT_DATASET_ID=${DSL_EXPORT_ENCRYPT_DATASET_ID:-true}

# Agent v2 / dify-agent backend. NEXT enables the visible Agent v2 surface,
# same-container backend, and local shellctl-backed shell layer by default.
export DIFY_AGENT_ENABLED=${DIFY_AGENT_ENABLED:-true}
export DIFY_AGENT_HOST=${DIFY_AGENT_HOST:-127.0.0.1}
export DIFY_AGENT_PORT=${DIFY_AGENT_PORT:-5005}
export DIFY_AGENT_STARTUP_DELAY_SECONDS=${DIFY_AGENT_STARTUP_DELAY_SECONDS:-30}
export AGENT_BACKEND_BASE_URL=${AGENT_BACKEND_BASE_URL:-}
export AGENT_BACKEND_USE_FAKE=${AGENT_BACKEND_USE_FAKE:-false}
export AGENT_BACKEND_FAKE_SCENARIO=${AGENT_BACKEND_FAKE_SCENARIO:-success}
export AGENT_SHELL_ENABLED=${AGENT_SHELL_ENABLED:-true}
export AGENT_DRIVE_MANIFEST_ENABLED=${AGENT_DRIVE_MANIFEST_ENABLED:-true}
export DIFY_AGENT_REDIS_URL=${DIFY_AGENT_REDIS_URL:-}
export DIFY_AGENT_REDIS_PREFIX=${DIFY_AGENT_REDIS_PREFIX:-dify-agent-next}
export DIFY_AGENT_PLUGIN_DAEMON_URL=${DIFY_AGENT_PLUGIN_DAEMON_URL:-http://127.0.0.1:5002}
export DIFY_AGENT_PLUGIN_DAEMON_API_KEY=${DIFY_AGENT_PLUGIN_DAEMON_API_KEY:-}
export DIFY_AGENT_DIFY_API_BASE_URL=${DIFY_AGENT_DIFY_API_BASE_URL:-http://127.0.0.1:5001}
export DIFY_AGENT_DIFY_API_INNER_API_KEY=${DIFY_AGENT_DIFY_API_INNER_API_KEY:-}
export DIFY_AGENT_SHELLCTL_ENTRYPOINT=${DIFY_AGENT_SHELLCTL_ENTRYPOINT:-http://127.0.0.1:5004}
export DIFY_AGENT_SHELLCTL_AUTH_TOKEN=${DIFY_AGENT_SHELLCTL_AUTH_TOKEN:-}
export DIFY_AGENT_STUB_URL=${DIFY_AGENT_STUB_URL:-}
export DIFY_AGENT_STUB_GRPC_BIND_ADDRESS=${DIFY_AGENT_STUB_GRPC_BIND_ADDRESS:-}
export DIFY_AGENT_SERVER_SECRET_KEY=${DIFY_AGENT_SERVER_SECRET_KEY:-}

# Storage: local filesystem on /data.
export STORAGE_TYPE=${STORAGE_TYPE:-opendal}
export OPENDAL_SCHEME=${OPENDAL_SCHEME:-fs}
export OPENDAL_FS_ROOT=${OPENDAL_FS_ROOT:-/data/dify/storage}

# Vector store: pgvector instead of Weaviate to keep this demo single-container.
export VECTOR_STORE=${VECTOR_STORE:-pgvector}
export VECTOR_INDEX_NAME_PREFIX=${VECTOR_INDEX_NAME_PREFIX:-Vector_index}
export PGVECTOR_HOST=${PGVECTOR_HOST:-127.0.0.1}
export PGVECTOR_PORT=${PGVECTOR_PORT:-5432}
export PGVECTOR_USER=${PGVECTOR_USER:-${DB_USERNAME}}
export PGVECTOR_PASSWORD=${PGVECTOR_PASSWORD:-${DB_PASSWORD}}
export PGVECTOR_DATABASE=${PGVECTOR_DATABASE:-${DB_DATABASE}}
export PGVECTOR_MIN_CONNECTION=${PGVECTOR_MIN_CONNECTION:-1}
export PGVECTOR_MAX_CONNECTION=${PGVECTOR_MAX_CONNECTION:-5}

# Sandbox. Default to no network access for training safety.
export CODE_EXECUTION_ENDPOINT=${CODE_EXECUTION_ENDPOINT:-http://127.0.0.1:8194}
export CODE_EXECUTION_API_KEY=${CODE_EXECUTION_API_KEY:-}
export CODE_EXECUTION_SSL_VERIFY=${CODE_EXECUTION_SSL_VERIFY:-true}
export CODE_EXECUTION_POOL_MAX_CONNECTIONS=${CODE_EXECUTION_POOL_MAX_CONNECTIONS:-100}
export CODE_EXECUTION_POOL_MAX_KEEPALIVE_CONNECTIONS=${CODE_EXECUTION_POOL_MAX_KEEPALIVE_CONNECTIONS:-20}
export CODE_EXECUTION_POOL_KEEPALIVE_EXPIRY=${CODE_EXECUTION_POOL_KEEPALIVE_EXPIRY:-5.0}
export CODE_EXECUTION_CONNECT_TIMEOUT=${CODE_EXECUTION_CONNECT_TIMEOUT:-10}
export CODE_EXECUTION_READ_TIMEOUT=${CODE_EXECUTION_READ_TIMEOUT:-60}
export CODE_EXECUTION_WRITE_TIMEOUT=${CODE_EXECUTION_WRITE_TIMEOUT:-10}
export SANDBOX_API_KEY=${SANDBOX_API_KEY:-${CODE_EXECUTION_API_KEY}}
export SANDBOX_GIN_MODE=${SANDBOX_GIN_MODE:-release}
export SANDBOX_WORKER_TIMEOUT=${SANDBOX_WORKER_TIMEOUT:-15}
export SANDBOX_ENABLE_NETWORK=${SANDBOX_ENABLE_NETWORK:-false}
export SANDBOX_HTTP_PROXY=${SANDBOX_HTTP_PROXY:-}
export SANDBOX_HTTPS_PROXY=${SANDBOX_HTTPS_PROXY:-}
export SANDBOX_PORT=${SANDBOX_PORT:-8194}
export SANDBOX_PYTHON_PATH=${SANDBOX_PYTHON_PATH:-/opt/dify/sandbox/python3-sandbox}
export SANDBOX_NODEJS_PATH=${SANDBOX_NODEJS_PATH:-/usr/bin/node}
# Hugging Face Docker Spaces run inside a rootless/userns environment where
# arbitrary sandbox UIDs such as 10000 are not mapped. NEXT uses a patched
# sandbox binary that keeps chroot/seccomp but defaults execution back to the
# mapped Space user/group.
export SANDBOX_UID_POOL_MIN=${SANDBOX_UID_POOL_MIN:-1000}
export SANDBOX_UID_POOL_MAX=${SANDBOX_UID_POOL_MAX:-1001}
export SANDBOX_RUN_GID=${SANDBOX_RUN_GID:-1000}
export SANDBOX_SELFCHECK_ENABLED=${SANDBOX_SELFCHECK_ENABLED:-true}
export SANDBOX_SELFCHECK_STRICT=${SANDBOX_SELFCHECK_STRICT:-false}
export SANDBOX_SELFCHECK_RESULT_PATH=${SANDBOX_SELFCHECK_RESULT_PATH:-${RUNTIME_ROOT}/sandbox-selfcheck.json}
export SANDBOX_SELFCHECK_TIMEOUT_SECONDS=${SANDBOX_SELFCHECK_TIMEOUT_SECONDS:-30}
# Blank means entrypoint/with-sandbox-env auto-detect the GNU triplet for the
# current architecture while preserving explicit external overrides.
export SANDBOX_PYTHON_LIB_PATH=${SANDBOX_PYTHON_LIB_PATH:-}
# Dify Sandbox makes copied rootfs files read-only. In HF rootless containers,
# frequent refreshes try to overwrite those files and flood logs with cp errors.
export SANDBOX_PYTHON_DEPS_UPDATE_INTERVAL=${SANDBOX_PYTHON_DEPS_UPDATE_INTERVAL:-876000h}
export PIP_MIRROR_URL=${PIP_MIRROR_URL:-}

# Plugin Daemon.
export DB_PLUGIN_DATABASE=${DB_PLUGIN_DATABASE:-dify_plugin}
export PLUGIN_DAEMON_HOST=${PLUGIN_DAEMON_HOST:-0.0.0.0}
export PLUGIN_DAEMON_PORT=${PLUGIN_DAEMON_PORT:-5002}
export PLUGIN_DAEMON_KEY=${PLUGIN_DAEMON_KEY:-}
export PLUGIN_DAEMON_URL=${PLUGIN_DAEMON_URL:-http://127.0.0.1:5002}
export PLUGIN_MAX_PACKAGE_SIZE=${PLUGIN_MAX_PACKAGE_SIZE:-52428800}
export PLUGIN_MODEL_SCHEMA_CACHE_TTL=${PLUGIN_MODEL_SCHEMA_CACHE_TTL:-3600}
export PLUGIN_MODEL_PROVIDERS_CACHE_TTL=${PLUGIN_MODEL_PROVIDERS_CACHE_TTL:-86400}
export PLUGIN_PPROF_ENABLED=${PLUGIN_PPROF_ENABLED:-false}
export PLUGIN_DEBUGGING_HOST=${PLUGIN_DEBUGGING_HOST:-0.0.0.0}
export PLUGIN_DEBUGGING_PORT=${PLUGIN_DEBUGGING_PORT:-5003}
export PLUGIN_DIFY_INNER_API_KEY=${PLUGIN_DIFY_INNER_API_KEY:-}
export PLUGIN_DIFY_INNER_API_URL=${PLUGIN_DIFY_INNER_API_URL:-http://127.0.0.1:5001}
export INNER_API_KEY_FOR_PLUGIN=${INNER_API_KEY_FOR_PLUGIN:-${PLUGIN_DIFY_INNER_API_KEY}}
export FORCE_VERIFYING_SIGNATURE=${FORCE_VERIFYING_SIGNATURE:-false}
export THIRD_PARTY_SIGNATURE_VERIFICATION_ENABLED=${THIRD_PARTY_SIGNATURE_VERIFICATION_ENABLED:-false}
export THIRD_PARTY_SIGNATURE_VERIFICATION_PUBLIC_KEYS=${THIRD_PARTY_SIGNATURE_VERIFICATION_PUBLIC_KEYS:-}
export ENFORCE_LANGGENIUS_PLUGIN_SIGNATURES=${ENFORCE_LANGGENIUS_PLUGIN_SIGNATURES:-false}
export PLUGIN_STDIO_BUFFER_SIZE=${PLUGIN_STDIO_BUFFER_SIZE:-1024}
export PLUGIN_STDIO_MAX_BUFFER_SIZE=${PLUGIN_STDIO_MAX_BUFFER_SIZE:-5242880}
export PLUGIN_PYTHON_ENV_INIT_TIMEOUT=${PLUGIN_PYTHON_ENV_INIT_TIMEOUT:-120}
export PLUGIN_MAX_REQUEST_TIMEOUT=${PLUGIN_MAX_REQUEST_TIMEOUT:-300}
export PLUGIN_CONNECT_TIMEOUT_SECONDS=${PLUGIN_CONNECT_TIMEOUT_SECONDS:-60}
export PLUGIN_MAX_EXECUTION_TIMEOUT=${PLUGIN_MAX_EXECUTION_TIMEOUT:-600}
export PLUGIN_STORAGE_TYPE=${PLUGIN_STORAGE_TYPE:-local}
export PLUGIN_STORAGE_LOCAL_ROOT=${PLUGIN_STORAGE_LOCAL_ROOT:-/data/plugin_daemon}
export PLUGIN_WORKING_PATH=${PLUGIN_WORKING_PATH:-/data/plugin_daemon/cwd}
export PLUGIN_UV_CACHE_DIR=${PLUGIN_UV_CACHE_DIR:-${RUNTIME_ROOT}/plugin-uv-cache}
export PLUGIN_INSTALLED_PATH=${PLUGIN_INSTALLED_PATH:-plugin}
export PLUGIN_PACKAGE_CACHE_PATH=${PLUGIN_PACKAGE_CACHE_PATH:-plugin_packages}
export PLUGIN_MEDIA_CACHE_PATH=${PLUGIN_MEDIA_CACHE_PATH:-assets}
export MARKETPLACE_ENABLED=${MARKETPLACE_ENABLED:-true}
export PLUGIN_IGNORE_UV_LOCK=${PLUGIN_IGNORE_UV_LOCK:-false}
export PYTHON_COMPILE_ALL_EXTRA_ARGS=${PYTHON_COMPILE_ALL_EXTRA_ARGS:--x \.venv}
export PYTHON_INTERPRETER_PATH=${PYTHON_INTERPRETER_PATH:-/usr/local/bin/python3}
export UV_PATH=${UV_PATH:-/usr/local/bin/uv}

# Nginx
export NGINX_PORT=${NGINX_PORT:-7860}
export NGINX_CLIENT_MAX_BODY_SIZE=${NGINX_CLIENT_MAX_BODY_SIZE:-100M}

# Read-only diagnostics service exposed by Nginx under /_ops.
export OPS_HOST=${OPS_HOST:-127.0.0.1}
export OPS_PORT=${OPS_PORT:-8081}
export OPS_TOKEN=${OPS_TOKEN:-dify_ops_demo_token}
export ALLOW_DEMO_OPS_TOKEN=${ALLOW_DEMO_OPS_TOKEN:-false}
export OPS_CACHE_TTL_SECONDS=${OPS_CACHE_TTL_SECONDS:-5}
export OPS_SESSION_TTL_SECONDS=${OPS_SESSION_TTL_SECONDS:-3600}
export OPS_COOKIE_SECURE=${OPS_COOKIE_SECURE:-auto}
export OPS_HTTP_TIMEOUT_SECONDS=${OPS_HTTP_TIMEOUT_SECONDS:-30}
export OPS_DEFAULT_CHECKS_ENABLED=${OPS_DEFAULT_CHECKS_ENABLED:-true}
export OPS_EXTRA_HTTP_CHECKS_JSON=${OPS_EXTRA_HTTP_CHECKS_JSON:-}
export OPS_EXTRA_TCP_CHECKS_JSON=${OPS_EXTRA_TCP_CHECKS_JSON:-}
export OPS_LOG_DIR=${OPS_LOG_DIR:-/data/logs}
export OPS_LOG_SERVICES_JSON=${OPS_LOG_SERVICES_JSON:-}
export OPS_LOG_LINES_MAX=${OPS_LOG_LINES_MAX:-1000}
export OPS_LOG_TAIL_MAX_BYTES=${OPS_LOG_TAIL_MAX_BYTES:-1048576}

# Controlled admin surface exposed by Nginx under /_admin. It is default-off
# and requires a separate ADMIN_TOKEN before it becomes usable.
export ADMIN_ENABLED=${ADMIN_ENABLED:-false}
export ADMIN_HOST=${ADMIN_HOST:-127.0.0.1}
export ADMIN_PORT=${ADMIN_PORT:-8082}
export ADMIN_TOKEN=${ADMIN_TOKEN:-}
export ADMIN_CSRF_KEY=${ADMIN_CSRF_KEY:-}
export ADMIN_SESSION_TTL_SECONDS=${ADMIN_SESSION_TTL_SECONDS:-3600}
export ADMIN_COOKIE_SECURE=${ADMIN_COOKIE_SECURE:-auto}
export ADMIN_HTTP_TIMEOUT_SECONDS=${ADMIN_HTTP_TIMEOUT_SECONDS:-30}
export ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=${ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS:-300}
export ADMIN_LOGIN_RATE_LIMIT_BLOCK_SECONDS=${ADMIN_LOGIN_RATE_LIMIT_BLOCK_SECONDS:-300}
export ADMIN_LOGIN_RATE_LIMIT_MAX_PER_IP=${ADMIN_LOGIN_RATE_LIMIT_MAX_PER_IP:-5}
export ADMIN_LOGIN_RATE_LIMIT_MAX_GLOBAL=${ADMIN_LOGIN_RATE_LIMIT_MAX_GLOBAL:-30}
